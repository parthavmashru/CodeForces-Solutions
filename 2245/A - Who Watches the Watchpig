#include <bits/stdc++.h>
using namespace std;
 
#define ll long long
 
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,k;
        cin>>n>>k;
        string s;
        cin>>s;
 
        if(2*k>n)
        {
            cout<<-1<<endl;
            continue;
        }
 
        int ans=0;
 
        for(int i=0;i<k;i++)
        {
            if(s[i]!='R') ans++;
            if(s[n-i-1]!='L') ans++;
        }
 
        cout<<ans<<endl;
    }
}